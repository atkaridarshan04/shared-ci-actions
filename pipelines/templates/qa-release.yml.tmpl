name: QA release pipeline

on:
  push:
    branches:
      - release-*

env:
  REGISTRY: ghcr.io
  # GHCR paths must be lowercase; set this explicitly if your owner or repo
  # name has uppercase letters.
  IMAGE_NAME: ${{ github.repository }}
  IMAGE_TAG: ${{ github.ref_name }}-{{SERVICE_NAME}}

permissions:
  contents: read

jobs:
  build-scan-push:
    name: Build, Trivy Scan, and Push
    runs-on: {{RUNNER}}
    permissions:
      contents: read
      packages: write
      pull-requests: write
    outputs:
      image_tag: ${{ env.IMAGE_TAG }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - id: pr
        uses: atkaridarshan04/shared-ci-actions/.github/actions/resolve-pr-for-branch@{{ACTIONS_REF}}
        with:
          branch: ${{ github.ref_name }}

      # build and scan before logging in: nothing unscanned can reach the registry
      - uses: atkaridarshan04/shared-ci-actions/.github/actions/build-candidate-image@{{ACTIONS_REF}}
        with:
          image-tag: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${{ env.IMAGE_TAG }}
{{EXTRA_BUILD_INPUTS}}

      - uses: atkaridarshan04/shared-ci-actions/.github/actions/trivy-scan-and-comment@{{ACTIONS_REF}}
        with:
          image-ref: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${{ env.IMAGE_TAG }}
          label: {{SERVICE_LABEL}} image
          pr-number: ${{ steps.pr.outputs.pr-number }}

      - uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4.6.0
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Push image
        run: docker push "${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"

  update-helm-repo:
    name: Update QA values.yaml (PR to {{INTEGRATION_BRANCH}})
    runs-on: {{RUNNER}}
    needs: build-scan-push
    steps:
      - id: helm-app-token
        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
        with:
          app-id: ${{ vars.HELM_BOT_APP_ID }}
          private-key: ${{ secrets.HELM_BOT_APP_PRIVATE_KEY }}
          owner: {{HELM_OWNER}}
          repositories: {{HELM_REPO_NAME}}
      - uses: atkaridarshan04/shared-ci-actions/.github/actions/update-helm-chart@{{ACTIONS_REF}}
        with:
          yaml-path: {{HELM_KEY}}
          helm-repo: {{HELM_REPO}}
          values-file: qa/values.yaml
          image-tag: ${{ needs.build-scan-push.outputs.image_tag }}
          component-label: {{SERVICE_NAME}}
          helm-repo-token: ${{ steps.helm-app-token.outputs.token }}
          mode: pr
          source-branch: ${{ github.ref_name }}
          target-branch: {{INTEGRATION_BRANCH}}
