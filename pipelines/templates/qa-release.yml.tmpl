name: QA release pipeline

on:
  push:
    branches:
      - release-*

jobs:
  qa-release:
    uses: atkaridarshan04/shared-ci-actions/.github/workflows/qa-release.yml@{{ACTIONS_REF}}
    permissions:
      contents: read
      packages: write
      pull-requests: write
    with:
      service-name: {{SERVICE_NAME}}
      service-label: {{SERVICE_LABEL}}
      helm-key: {{HELM_KEY}}
{{EXTRA_BUILD_INPUTS}}
      integration-branch: {{INTEGRATION_BRANCH}}
      helm-repo: {{HELM_REPO}}
      helm-owner: {{HELM_OWNER}}
      helm-repo-name: {{HELM_REPO_NAME}}
      runner: {{RUNNER}}
      helm-bot-client-id: ${{ vars.HELM_BOT_CLIENT_ID }}
    secrets:
      helm-bot-app-private-key: ${{ secrets.HELM_BOT_APP_PRIVATE_KEY }}
